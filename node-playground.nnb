                "import Song from './Song.js';\nimport fs from 'node:fs';\n\nconst allChordsFile = fs.readFileSync('./songs/All-Chords.js', 'utf8');\n\nconst allChordsJsonString = allChordsFile\n    .replace(/^\\s*export\\s+default\\s+/, '')\n    .replace(/;\\s*$/, '');\n\nconst allChords = JSON.parse(allChordsJsonString);\n\n// expose for other cells\nglobalThis.namedNotes =\n    allChords.sections?.[0]?.namedNotes ?? allChords.Sections?.[0]?.namedNotes;\n"
