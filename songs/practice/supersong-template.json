  "macros": {
    "fill-named-C": {
      "lines": [
        "/fpfgri \"fill-named-diatonic-transparent\"",
        "/skwc",
        "/fpfocM",
        "/fpfA",
        "/fpfM"
      ]
    },
    "fill-tiny-automatic": {
      "lines": [
        "# Clone from already-prepared following Section, then previous to go back from the clone to the already-prepared Section for adding the tiny note chord, always leaving a blank clone (with C diatonic named notes) at the end.",
        "/snn",
        "/sec",
        "/snp",
        "",
        "# Now add the tiny notes in the new key, then reset key to C, then set lead key to new key",
        "",
        "/fpfgri \"fill-tiny-root-chord-automatic\"",
        "/sk${key}",
        "/fpfoc${chord}",
        "/fpfA",
        "/fpfM",
        "/skwc",
        "/sl${key}",
        "/fmp \"caption: -${caption}-\"",
        "/sc \"${caption}\"",
        "/fmp \"created ${key} ${chord} in Section ${currentSectionCardinal}\"",
        "/vdu"
      ]
    },
    "fill-one-key": {
      "lines": [
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"M\", \"caption\":\"${keyname} major\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"s\", \"caption\":\"${keyname} minor 7\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"i\", \"caption\":\"${keyname} dim 7\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"b\", \"caption\":\"${keyname} m7b5\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"2\", \"caption\":\"${keyname} Sus2\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"4\", \"caption\":\"${keyname} Sus4\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"a\", \"caption\":\"${keyname} Maj 7 (&Delta;)\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"7\", \"caption\":\"${keyname} dom 7\"}}",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"${key}\", \"chord\":\"6\", \"caption\":\"${keyname} 6add9\"}}",
        ""
      ]
    },
    "call-fill-one-key": {
      "lines": [
        "/fmc {\"macro\":\"fill-one-key\", \"args\":{\"key\":\"wf\", \"keyname\":\"F\"}}",
        ""
      ]
    },
