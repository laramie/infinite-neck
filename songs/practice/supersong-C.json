    "fill-tiny-automatic": {
      "lines": [
        "/fpfgri \"fill-tiny-root-chord-automatic\"",
        "/sk${key}",
        "/fpfoc${chord}",
        "/fpfA",
        "/fpfM",
        "/skwc",
        "/sl${key}",
        "/fmp \"caption: -${caption}-\"",
        "/sc \"${caption}\"",
        "/fmp \"created ${key} ${chord} in Section ${currentSectionCardinal}\"",
        "/vdu"
      ]
    },
    "call-all": {
      "lines": [
        "# Make one blank new Section with C diatonic named notes",
        "/sa",
        "/fmc {\"macro\":\"fill-named-C\", \"args\":{}}",
        "",
        "# Clone, then previous for adding the tiny note chord, always leaving a blank clone (with C diatonic named notes) at the end.",
        "",
        "/sec",
        "/snp",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"wa\", \"chord\":\"M\", \"caption\":\"A major\"}}",
        "",
        "/snn",
        "/sec",
        "/snp",
        "/fmc {\"macro\":\"fill-tiny-automatic\", \"args\":{\"key\":\"wa\", \"chord\":\"s\", \"caption\":\"A minor 7\"}}",
        "",
        "/snn",
